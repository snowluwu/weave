#include <windows.h>
#include "version.h"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION WEAVE_FILE_VERSION
 PRODUCTVERSION WEAVE_FILE_VERSION
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "weave SOCKS5 proxy"
            VALUE "FileVersion", WEAVE_FILE_VERSION_STRING
            VALUE "ProductName", "weave"
            VALUE "ProductVersion", WEAVE_VERSION
            VALUE "OriginalFilename", "weave_proxy.dll"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
